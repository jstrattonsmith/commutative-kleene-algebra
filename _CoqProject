-arg "-w -convert_concl_no_check"
-arg "-w -redundant-canonical-projection"
-arg "-w -notation-overridden"

-R . kacc

# MM2/: RtcBridge.v, CKA-specific glue bridging Coq's clos_refl_trans to
# stdpp's relations.rtc. Simulator.v moved to Legacy/ below.
MM2/RtcBridge.v

# MM2/Legacy/: not on the critical path, kept for their own interest.
#
# TLUniform_MM2.v/MM2_PrefixSplice.v: an earlier, self-contained
# axiom-free S-M-N-style construction directly at the MM2 level,
# predating and superseded by the T_L-based route above (used in the
# main argument). Genuinely MM2-generic, no CKA content.
MM2/Legacy/TLUniform_MM2.v
MM2/Legacy/MM2_PrefixSplice.v

# Simulator.v: builds Theta_MM2 and its halting sets, kept free of any
# CKAUndec/ dependency (no ssreflect) -- see its own header comment.
MM2/Legacy/Simulator.v

# MM2/Legacy/EffectiveInseparability_MM2_Race.v and MM2/Legacy/SMN_MM2.v
# are excluded here, not deleted: their semidec_of_MM2_computable needs
# MetaRocq's `extract` to bridge a `computable` instance across this
# file boundary, which fails. Not on the critical path.
# MM2/Legacy/EffectiveInseparability_MM2_Race.v
# MM2/Legacy/SMN_MM2.v

# KA/: the paper's own pre-Kleene-algebra framework. Independent of
# MM2/CKA -- touches none of them.
KA/utils.v
KA/algebra.v
KA/pre_ka.v
KA/enumerable.v
KA/lang.v
KA/automata.v
KA/repr_rel.v
KA/BinaryAlphabetTransport.v
KA/bounded_output.v
KA/BoundedOutputTransport.v

# CKAUndec/: the actual encoding of MM2 as pre-Kleene-algebra terms and
# everything built on red_lb/red_ub/mm2_R, including red_leq/R_target.
# CKAUndec/Glue/ files are thin connective code wiring MM2/ and
# coq-synthetic-computability's Models/T_L_Bridge.v/EA_L.v/EA_L_Myhill.v
# into CKAUndec/.
CKAUndec/Encoding.v
CKAUndec/Glue/TLToRTarget.v
CKAUndec/K.v
CKAUndec/KEnumerable.v
CKAUndec/KMComplete.v
CKAUndec/BinaryAlphabet.v
CKAUndec/Glue/BinaryAlphabetConnection.v
CKAUndec/BinaryAlphabetMComplete.v

# SimulatorToRTarget.v: connects MM2/Legacy/Simulator.v's Theta_MM2 to
# CKAUndec/Encoding.v's R_target (plus an embedded-alphabet analogue) --
# a proven alternative to the T_L-based route actually used. Kept
# separate from Simulator.v so that file can stay ssreflect-free.
MM2/Legacy/SimulatorToRTarget.v
