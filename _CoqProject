-arg "-w -convert_concl_no_check"
-arg "-w -redundant-canonical-projection"
-arg "-w -notation-overridden"

-R . kacc

# MM2_Legacy/: not on the critical path, kept for their own interest.
#
# TLUniform_MM2.v/MM2_PrefixSplice.v: an earlier, self-contained
# axiom-free S-M-N-style construction directly at the MM2 level,
# predating and superseded by the T_L-based route above (used in the
# main argument). Genuinely MM2-generic, no CKA content.
MM2_Legacy/TLUniform_MM2.v
MM2_Legacy/MM2_PrefixSplice.v

# Simulator.v: builds Theta_MM2 and its halting sets, kept free of any
# CKAUndec/ dependency (no ssreflect) -- see its own header comment.
MM2_Legacy/Simulator.v

# MM2_Legacy/EffectiveInseparability_MM2_Race.v and MM2_Legacy/SMN_MM2.v
# are excluded here, not deleted: their semidec_of_MM2_computable needs
# MetaRocq's `extract` to bridge a `computable` instance across this
# file boundary, which fails. Not on the critical path.
# MM2_Legacy/EffectiveInseparability_MM2_Race.v
# MM2_Legacy/SMN_MM2.v

# KA/: the paper's own pre-Kleene-algebra framework. Independent of
# MM2_Legacy/CKAUndec -- touches none of them.
KA/utils.v
KA/algebra.v
KA/pre_ka.v
KA/rules_enumerable.v
KA/preka_enumerable.v
KA/lang.v
# ka.v/ka_enumerable.v: full Kleene algebras (star induction) and the
# free KA, used by Universality/.
KA/ka.v
KA/ka_enumerable.v
KA/automata.v
KA/repr_rel.v
KA/BinaryAlphabetTransport.v
KA/bounded_output.v
KA/BoundedOutputTransport.v

# CKAUndec/: the actual encoding of MM2 as pre-Kleene-algebra terms and
# everything built on red_lb/red_ub/mm2_R, including red_leq/R_target.
# CKAUndec/Glue/ files are thin connective code wiring MM2/ and
# coq-synthetic-computability's Models/T_L_Bridge.v/EA_L.v/EA_L_Myhill.v
# into CKAUndec/.
CKAUndec/Encoding.v

# RtcBridge.v: CKA-specific glue bridging Coq's clos_refl_trans to
# stdpp's relations.rtc, used by the two Glue files below (and by
# MM2_Legacy/SimulatorToRTarget.v further down).
CKAUndec/Glue/RtcBridge.v
CKAUndec/Glue/TLToRTarget.v
CKAUndec/K.v
CKAUndec/KEnumerable.v
CKAUndec/KMComplete.v
CKAUndec/BinaryAlphabet.v
CKAUndec/Glue/BinaryAlphabetConnection.v
CKAUndec/BinaryAlphabetMComplete.v

# Universality/: a second, independent MM2 encoding via balanced
# universality over list T * nat (after Xu, Zhou, Walker and Kincaid);
# see Universality/README.md.
# Depends on KA/ and CKAUndec/; nothing outside it depends on it.
Universality/balanced.v
Universality/BalancedBinary.v
Universality/BalancedKA.v
Universality/UnivEncoding.v
Universality/UnivTop.v
Universality/UnivConnection.v
Universality/UnivMComplete.v

# RegexUnif/: unification modulo KA (and pre-KA) is Sigma^0_1-complete,
# via regular inductive invariants of MM2 runs encoded as a two-ended
# Post normal system. Depends on KA/ and CKAUndec/; nothing outside it
# depends on it.
RegexUnif/Syntax.v
RegexUnif/StarFree.v
RegexUnif/Invariant.v
RegexUnif/MM2Deque.v
RegexUnif/MComplete.v

# SimulatorToRTarget.v: connects MM2_Legacy/Simulator.v's Theta_MM2 to
# CKAUndec/Encoding.v's R_target (plus an embedded-alphabet analogue) --
# a proven alternative to the T_L-based route actually used. Kept
# separate from Simulator.v so that file can stay ssreflect-free.
MM2_Legacy/SimulatorToRTarget.v
