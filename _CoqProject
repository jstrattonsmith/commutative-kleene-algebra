-arg "-w -convert_concl_no_check"
-arg "-w -redundant-canonical-projection"
-arg "-w -notation-overridden"

-R . kacc

# MM2/: pure two-counter-machine simulation, Godel-coding, and the
# FRACTRAN-to-MM2 compiler. Zero Kleene-algebra content.
MM2/Stepper.v
MM2/Simulator.v
MM2/FractranCompiler.v
MM2/Splice.v

# MM2/Legacy/: an earlier, self-contained axiom-free S-M-N-style
# construction directly at the MM2 level, predating the T_L-based route
# above (which superseded it for the main argument). Not on the
# critical path. Genuinely MM2-generic (no CKA content, confirmed).
MM2/Legacy/TLUniform_MM2.v
MM2/Legacy/MM2_PrefixSplice.v
MM2/Legacy/EffectiveInseparability_MM2_Race.v
MM2/Legacy/SMN_MM2.v

# Computability/: pure effective-inseparability/creative/m-complete
# theory over an abstract numbering, plus T_L/CT_L/EA bridging. Zero
# MM2 or KA content; genuinely upstreamable to coq-synthetic-computability.
Computability/InseparabilityCore.v
Computability/TL_Bridge.v
Computability/EA_L.v
Computability/Myhill.v

# KA/: the paper's own pre-Kleene-algebra framework. Independent of
# MM2/Computability/CKA -- touches none of them.
KA/utils.v
KA/algebra.v
KA/pre_ka.v
KA/enumerable.v
KA/lang.v
KA/automata.v
KA/repr_rel.v
KA/BinaryAlphabetTransport.v
KA/bounded_output.v
KA/BoundedOutputTransport.v

# CKA/: the actual encoding of MM2 as pre-Kleene-algebra terms and
# everything built on red_lb/red_ub/mm2_R. CKA/Glue/ files are thin
# connective code wiring MM2/ and Computability/ into CKA/.
CKA/Encoding.v
CKA/Glue/MM2ToKATerm.v
CKA/Glue/TLToRTarget.v
CKA/K.v
CKA/KEnumerable.v
CKA/KMComplete.v
CKA/BinaryAlphabet.v
CKA/Glue/BinaryAlphabetConnection.v
CKA/BinaryAlphabetMComplete.v
